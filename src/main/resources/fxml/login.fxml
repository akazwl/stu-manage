<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.stumanage.fx.controller.LoginController"
      styleClass="login-bg" alignment="CENTER" spacing="0">

    <!-- 登录卡片 -->
    <VBox styleClass="login-card" maxWidth="400" spacing="20">
        <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

        <!-- Logo区域：山大软院院徽 -->
        <HBox alignment="CENTER" spacing="0">
            <ImageView fitWidth="100" fitHeight="100" preserveRatio="true">
                <Image url="@/images/logo.png"/>
            </ImageView>
        </HBox>

        <!-- 标题 -->
        <VBox alignment="CENTER" spacing="4">
            <Label text="学生综合管理系统" styleClass="login-title"/>
            <Label text="山东大学软件学院" styleClass="login-subtitle"/>
        </VBox>

        <Separator/>

        <!-- 角色选择 -->
        <Label text="选择身份" styleClass="form-label"/>
        <HBox spacing="10" alignment="CENTER">
            <ToggleButton fx:id="btnAdmin"  text="👤 管理员" styleClass="role-btn"/>
            <ToggleButton fx:id="btnTeacher" text="👨‍🏫 教师" styleClass="role-btn"/>
            <ToggleButton fx:id="btnStudent" text="🎓 学生" styleClass="role-btn"/>
            <fx:define>
                <ToggleGroup fx:id="roleGroup"/>
            </fx:define>
        </HBox>

        <!-- 用户名 -->
        <VBox spacing="4">
            <Label text="用户名" styleClass="form-label"/>
            <TextField fx:id="usernameField" promptText="请输入用户名" styleClass="login-field"/>
        </VBox>

        <!-- 密码 -->
        <VBox spacing="4">
            <Label text="密码" styleClass="form-label"/>
            <PasswordField fx:id="passwordField" promptText="请输入密码" styleClass="login-field"/>
        </VBox>

        <!-- 登录按钮 -->
        <Button fx:id="loginButton" text="登 录" styleClass="login-btn" maxWidth="Infinity"
                onAction="#handleLogin"/>

        <!-- 提示信息 -->
        <Label fx:id="messageLabel" text="" styleClass="login-subtitle" alignment="CENTER"
               maxWidth="Infinity" wrapText="true"/>
    </VBox>
</VBox>
